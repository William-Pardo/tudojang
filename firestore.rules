rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Funciones auxiliares
    // =========================================================================

    function authenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return authenticated() && currentRole() == 'SuperAdmin';
    }

    function currentUser() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function hasCurrentUser() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function currentTenantId() {
      return request.auth.token.tenantId != null
        ? request.auth.token.tenantId
        : (hasCurrentUser() ? currentUser().tenantId : null);
    }

    function currentRole() {
      return request.auth.token.rol != null
        ? request.auth.token.rol
        : (hasCurrentUser() ? currentUser().rol : null);
    }

    function ownsTicket() {
      return authenticated()
        && resource.data.userId == request.auth.uid
        && resource.data.tenantId == currentTenantId();
    }

    // Roles con acceso admin dentro del tenant
    function isAdmin() {
      return authenticated()
        && currentTenantId() != null
        && currentRole() in ['Admin', 'SuperAdmin'];
    }

    // Rol Instructor con acceso operativo. Incluye 'Maestro' (rol docente real desde
    // 14.9) y 'Editor'/'Asistente' (acceso operativo de Agenda, no necesariamente
    // docentes). Ver DT-0019: esta funcion nunca se actualizo cuando 'Maestro' se separo
    // de 'Editor' como rol propio, bloqueando en la practica a los maestros reales.
    function isInstructor() {
      return authenticated()
        && currentRole() in ['Admin', 'Editor', 'Asistente', 'Maestro', 'SuperAdmin'];
    }

    // Rol Estudiante acadÃ©mico
    function isEstudiante() {
      return authenticated() && currentRole() == 'Estudiante';
    }

    // Rol Tutor (padre/acudiente) â€” solo lectura sobre recursos relacionados
    function isTutor() {
      return authenticated() && currentRole() == 'Tutor';
    }

    function tutorLinkedToStudent(tenantId, uid) {
      return isTutor()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/vinculos/$(request.auth.token.email + "_" + uid));
    }

    function canReadProgress(tenantId, uid) {
      return authenticated()
        && currentTenantId() == tenantId
        && (request.auth.uid == uid || isAdmin() || tutorLinkedToStudent(tenantId, uid));
    }

    function canWriteOwnStudentProgress(tenantId, uid) {
      return authenticated()
        && currentTenantId() == tenantId
        && request.auth.uid == uid
        && isEstudiante();
    }

    // Defensa en profundidad (2026-07-18): linkPagoMensualidad es el Payment Link externo
    // (Wompi/PayU/ePayco) de la CUENTA de la academia -- Tudojang no procesa ese dinero, pero
    // igual valida que el dominio pertenezca a una pasarela conocida antes de persistirlo, por
    // si el frontend fuera bypaseado. La validación real y la whitelist "fuente de verdad"
    // viven en constantes.ts (DOMINIOS_PASARELAS_PAGO_PERMITIDOS) -- si se agrega/quita una
    // pasarela ahí, esta regex debe actualizarse manualmente en paralelo (no hay forma de
    // compartir la lista entre el bundle de frontend y las reglas de Firestore).
    function linkPagoMensualidadValido() {
      let link = request.resource.data.get('linkPagoMensualidad', '');
      return link == ''
        || link.matches('https://(checkout\\.wompi\\.co|checkout\\.payulatam\\.com|checkout\\.epayco\\.co|secure\\.payco\\.co)/.*');
    }

    // SDD pricing-cupo-real (D7, design.md "Protecting billing-affecting tenant fields"):
    // estos 4 campos determinan directamente cuanto se le cobra a un tenant (bono de sede +
    // extras contratados de sede/equipo tecnico) -- antes cualquier Admin del club podia
    // otorgarse una sede o un cupo extra gratis con un `updateDoc(increment(...))` directo
    // desde la consola del navegador (bug real cerrado por este guard, ver
    // servicios/configuracionApi.ts::actualizarCapacidadClub). Solo deben cambiar via Cloud
    // Function (Admin SDK, que bypasea estas reglas por completo -- ver
    // functions/academico/capacidad.js::actualizarExtrasContratados), nunca via un `update`
    // directo del cliente. `diff().affectedKeys()` -- mismo patron ya usado en
    // historialNotificaciones (rules:586) -- devuelve el set de claves agregadas/quitadas/
    // modificadas entre el documento nuevo y el existente; si ninguna de las 4 protegidas
    // esta en ese set, el resto de la condicion de `update` decide.
    function camposFacturacionInmutables() {
      let camposProtegidos = ['sedeBonusOtorgada', 'sedeBonusOtorgadaEn', 'sedesExtraContratadas', 'equipoTecnicoExtraContratado'];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposProtegidos);
    }

    // Misión KICHO: 'directo' es el sentinel del link fijo "Compartir Formulario" (sin
    // campaña, sin expiración por diseño -- ver MISION_ID_DIRECTO en constantes.ts). Para una
    // misión real, exige que siga activa Y no haya pasado su fechaExpiracion -- cierra el hueco
    // donde CensoPublico.tsx seguía aceptando registros después de que el contador del Admin
    // marcara "EXPIRADO" (esa cuenta regresiva era solo visual, nunca se validaba acá) y
    // habilita que el SuperAdmin corte la vigencia a mano (desactivarMisionKicho -> activa:false)
    // sin esperar a que se cumpla el plazo (MISION_KICHO_DURACION_DIAS, ver constantes.ts).
    function misionVigente(misionId) {
      let ref = /databases/$(database)/documents/misiones_kicho/$(misionId);
      return misionId == 'directo'
        || (exists(ref)
            && get(ref).data.activa == true
            && request.time < timestamp.value(get(ref).data.fechaExpiracion));
    }

    // =========================================================================
    // Colecciones existentes
    // =========================================================================

    match /tickets_soporte/{ticketId} {
      allow read: if isSuperAdmin() || ownsTicket();
      allow create, update, delete: if false;
    }

    match /asistente_cuotas/{quotaId} {
      allow read, write: if false;
    }

    match /asistente_telemetria/{eventId} {
      allow read, write: if false;
    }

    // SDD pricing-cupo-real (D6, design.md "Guardrail history storage"): historial diario de
    // estudiantes facturables por tenant, usado por functions/vigilanciaFacturacion.js para
    // detectar crecimiento anomalo (o una caida sospechosa cerca del corte, señal S3) --
    // server-only sin excepcion, ni siquiera SuperAdmin lee esto desde el cliente. Guardar el
    // historial en tenants/{tenantId}/privado/facturacion (Admin read/write desde el cliente,
    // D7) dejaria que el propio tenant manipule la serie que se usa para detectar SU PROPIA
    // anomalia -- ver D6 en design.md. Mismo patron server-only que asistente_cuotas/
    // asistente_telemetria arriba (no el patron mas permisivo de tickets_soporte, que sí deja
    // leer a SuperAdmin/owner).
    match /facturacion_vigilancia/{tenantId} {
      allow read, write: if false;
    }

    // Perfil de usuario autenticado usado durante login.
    match /usuarios/{uid} {
      // NOTA (ERR-0011): `get` queda sin condicion de tenant a proposito -- requiere
      // conocer el uid EXACTO de otro usuario (no hay enumeracion posible), y asi lo
      // determino el analisis previo de este fix. Es un piso mas bajo que `list`, que
      // exponia la coleccion ENTERA sin conocer ningun id -- ese es el hueco real que
      // cierra esta regla.
      allow get: if authenticated()
        && (request.auth.uid == uid || isAdmin());
      // ERR-0011: `list` no validaba tenant -- cualquier Admin podia listar TODOS los
      // usuarios de TODOS los tenants. Para `list`, Firestore evalua la regla contra el
      // resultado potencial de la query completa: si el cliente no filtra explicitamente
      // con where('tenantId','==', ...) (ver usuariosApi.ts::obtenerUsuarios), la query
      // completa se rechaza en cuanto exista un solo documento de otro tenant en la
      // coleccion -- exactamente el comportamiento fail-closed que buscamos.
      allow list: if isAdmin() && resource.data.tenantId == currentTenantId();
      allow create, update, delete: if false;
    }

    match /tenants/{tenantId} {
      allow get: if authenticated()
        && (currentTenantId() == tenantId || isSuperAdmin());
      allow list: if authenticated();
      allow create: if isAdmin()
        && currentTenantId() == tenantId
        && linkPagoMensualidadValido();
      // camposFacturacionInmutables() solo aplica a `update` (necesita `resource.data`, el
      // documento YA existente, contra el que diffear -- en `create` no hay documento previo).
      allow update: if isAdmin()
        && currentTenantId() == tenantId
        && linkPagoMensualidadValido()
        && camposFacturacionInmutables();
      allow delete: if false;
    }

    match /notificaciones_config/{tenantId} {
      allow read, write: if isAdmin()
        && currentTenantId() == tenantId;
    }

    // Datos privados de facturación del tenant (fix seguridad 2026-07-18: wompiPaymentSourceId
    // vivía en tenants/{tenantId} raíz, donde `allow get` permite a CUALQUIER usuario
    // autenticado del tenant leerlo -- Instructor/Editor/Asistente/Maestro no tienen por qué
    // ver el identificador de la fuente de pago Wompi del tenant. Se movió a este subdocumento
    // con el mismo patrón restrictivo que notificaciones_config/driveConnections: solo
    // Admin/SuperAdmin del propio tenant. cobroAutomaticoActivo/cobroAutomaticoIntentosFallidos
    // NO se movieron -- siguen en tenants/{tenantId} porque no son sensibles por sí solos y el
    // cron diario los necesita en una query directa sobre esa colección.
    match /tenants/{tenantId}/privado/{docId} {
      allow read, write: if isAdmin()
        && currentTenantId() == tenantId;
    }

    match /sedes/{docId} {
      allow read: if isInstructor();
      // Fix 2026-07-16 (bug real: puerta trasera del limite de sedes del plan -- el
      // conteo y la unicidad de nombre SOLO se validaban en el boton de la UI, nunca
      // aca. Cualquier Admin podia crear sedes ilimitadas via un write directo,
      // bypaseando el limite del plan por completo). Toda escritura ahora pasa por
      // createSede/updateSede/deleteSede (Cloud Functions), mismo criterio ya usado
      // para usuarios/{uid}.
      allow create, update, delete: if false;
    }

    // ERR-0011: ninguna condicion validaba tenant -- cualquier Instructor/Admin leia y
    // escribia programas de OTROS tenants. Mismo patron ya usado en tickets_soporte
    // (ownsTicket()): comparar resource.data.tenantId/request.resource.data.tenantId
    // contra currentTenantId(), sumado (no reemplazando) al chequeo de rol existente.
    match /programas/{docId} {
      allow read: if isInstructor() && resource.data.tenantId == currentTenantId();
      allow create: if isAdmin() && request.resource.data.tenantId == currentTenantId();
      allow update, delete: if isAdmin() && resource.data.tenantId == currentTenantId();
    }

    match /estudiantes/{docId} {
      // Fix tutor-role-end-to-end (2026-07-14): un Tutor (padre/acudiente) puede LEER
      // los estudiantes donde figura como acudiente (resource.data.tutor.correo ==
      // su email de login). El vínculo ya vive en el doc del estudiante, no hay que
      // calzar Auth UIDs. Como el query del Tutor filtra por `tutor.correo == suEmail`,
      // Firestore garantiza que solo recibe sus propios hijos.
      // Fix 2026-07-16 (bug reportado: Estudiante no veía material ni clases -- nunca se le
      // agregó el caso análogo al de Tutor): resolveStudentsForConsultor(tenantId, email,
      // esTutor=false) consulta where('correo', '==', email) para que el propio Estudiante
      // resuelva su registro -- esa query SIEMPRE fallaba con permission-denied porque esta
      // regla solo contemplaba isInstructor()/Tutor, nunca al propio Estudiante.
      // ERR-0011: ninguna de las 3 ramas de lectura validaba tenant -- un Instructor (o,
      // en teoria, un Tutor/Estudiante cuyo correo coincidiera por casualidad) de OTRO
      // tenant podia leer estudiantes ajenos. Se agrega resource.data.tenantId ==
      // currentTenantId() a las 3 ramas, sin tocar la logica de rol/vinculo existente.
      allow read: if (isInstructor() && resource.data.tenantId == currentTenantId())
        || (isTutor() && resource.data.tenantId == currentTenantId() && resource.data.tutor.correo == request.auth.token.email)
        || (isEstudiante() && resource.data.tenantId == currentTenantId() && resource.data.correo == request.auth.token.email);
      // Fix 2026-07-18 (bug real: puerta trasera del limite de estudiantes del plan -- el
      // limite (`limiteEstudiantes`, plan base + addons) SOLO se validaba en el boton de
      // la UI (hooks/useGestionEstudiantes.ts), nunca aca. Cualquier Instructor podia crear
      // estudiantes ilimitados via un write directo -- incluida la importacion masiva, que
      // llama al mismo punto de entrada en loop -- bypaseando el limite del plan por
      // completo. `create` ahora pasa exclusivamente por la Cloud Function `crearEstudiante`
      // (mismo criterio ya usado para `sedes/{id}`, ver academico/estudiantes.js).
      // `update`/`delete` NO cambian: se usan con mucha mas frecuencia que en sedes (cambios
      // de estado de pago, edicion de datos) y no tienen ningun hallazgo de limite asociado
      // -- mover esos tambien a Cloud Functions es un cambio de alcance mayor al bug real.
      allow create: if false;
      // ERR-0011: update/delete tampoco validaban tenant -- un Instructor de OTRO tenant
      // podia editar/borrar estudiantes ajenos conociendo (o adivinando) el docId.
      allow update, delete: if isInstructor() && resource.data.tenantId == currentTenantId();
    }

    // Misión KICHO: censo masivo de aspirantes (link/QR público -> revisión del tenant ->
    // legalización -> inyección a `estudiantes`). Nunca tuvieron match propio: caían en el
    // catch-all final (`allow read, write: if false`), bloqueando TODO acceso -- lectura del
    // propio Admin del tenant incluida -- para TODOS los clubes, siempre (mismo patrón de bug
    // que ERR-0010 en `asistencia`; reportado 2026-08-04 con perfil Cocodrilos pero no es
    // específico de ese tenant).
    match /misiones_kicho/{misionId} {
      // obtenerMisionPorId (CensoPublico.tsx, SIN login) necesita leer una misión puntual por
      // su id (opaco, no enumerable -- no hay `list` acá) para decidir si el formulario público
      // sigue vigente antes de mostrarlo. No expone nada explotable: el documento no tiene PII
      // de aspirantes, solo metadata de la campaña (y la firma de legalización, que ya viaja
      // detrás de un id no adivinable, mismo modelo de "link como capability" que el resto de
      // Misión KICHO).
      allow get: if true;
      // obtenerMisiones (MasterDashboard, SuperAdmin) lista TODAS las misiones sin filtro de
      // tenant; obtenerMisionActivaTenant/obtenerRegistrosMision (tenant, censoApi.ts) filtran
      // por su propio tenantId via where(). `list` sigue exigiendo rol -- a diferencia de `get`,
      // sin un id puntual esto sería enumerar la colección entera.
      allow list: if isSuperAdmin()
        || (isInstructor() && resource.data.tenantId == currentTenantId());
      // handleActivarKichoAuto (self-service, Admin/Editor, vistas/MisionKicho.tsx) crea para
      // su propio tenant; MasterDashboard (SuperAdmin) crea en nombre de CUALQUIER tenant al
      // aprobar una solicitud de Soporte.
      allow create: if isSuperAdmin()
        || (isInstructor() && request.resource.data.tenantId == currentTenantId());
      // legalizarLoteKicho (Admin del tenant) e inyectarEstudiantesKicho (SuperAdmin) escriben
      // autenticados. registrarAspirantePublico (censo público, SIN login) solo incrementa
      // `registrosRecibidos` sobre una misión activa -- se acota a esa única clave con
      // diff().affectedKeys() para no abrir el resto del documento a escritura anónima.
      allow update: if isSuperAdmin()
        || (isAdmin() && resource.data.tenantId == currentTenantId())
        || (resource.data.activa == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrosRecibidos']));
      allow delete: if isSuperAdmin();
    }

    // Registros temporales de aspirantes capturados por el censo público (con o sin campaña
    // Kicho activa detrás, ver MISION_ID_DIRECTO en vistas/MisionKicho.tsx). CensoPublico.tsx
    // escribe SIN login -- se valida que el tenantId exista y se fuerza estado:'pendiente' para
    // que el registro nazca en la bandeja de revisión, nunca ya aprobado/procesado.
    match /registros_temporales/{regId} {
      // obtenerRegistrosMision (SuperAdmin, vía MasterDashboard, para inyectarEstudiantesKicho)
      // lee registros de cualquier tenant por misionId; el tenant solo lee los propios.
      allow read: if isSuperAdmin() || (isInstructor() && resource.data.tenantId == currentTenantId());
      allow create: if request.resource.data.estado == 'pendiente'
        && exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId))
        && misionVigente(request.resource.data.misionId);
      // El Instructor del tenant puede aprobar/rechazar (validarRegistroTemporal, campo
      // `estado`) o corregir un typo capturado por el aspirante (actualizarDatosRegistroTemporal,
      // campo `datos`) -- nunca reasignar el registro a otro tenant/misión ni falsificar
      // fechaRegistro vía un update. SuperAdmin (soporte) sigue sin esta restricción.
      allow update: if isSuperAdmin()
        || (isInstructor() && resource.data.tenantId == currentTenantId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'datos']));
      allow delete: if isSuperAdmin() || (isInstructor() && resource.data.tenantId == currentTenantId());
    }

    // Asistencia de guarderia/entrega a tutores (Sistema C, colección raíz `asistencia`,
    // singular -- sin relación a `tenants/{t}/jornadas/{j}/asistencias`, plural, esa es
    // Clase en Vivo/JornadaInstruccion). Nunca tuvo regla propia: caía en el catch-all
    // final (`allow read, write: if false`), bloqueando el check-in de guardería para
    // TODOS los roles, siempre (bug real descubierto 2026-07-28, ver ERR-0010 en
    // bitacora.json). El documento no tiene campo `tenantId` (ver tipos.ts::Asistencia),
    // así que el aislamiento por tenant queda a nivel de rol (isInstructor()), mismo piso
    // de seguridad que ya tenía el resto de este flujo -- no se agrega tenantId acá para
    // no ampliar el alcance de este fix puntual.
    match /asistencia/{docId} {
      allow read, create, update: if isInstructor();
      allow delete: if false;
    }

    match /eventos/{docId} {
      // Fix tutor-role-end-to-end (2026-07-14): los consultores (Tutor/Estudiante) pueden LEER
      // los eventos del club para ver a cuáles aplican. Son anuncios del tenant, no datos
      // sensibles. Escritura sigue restringida a staff.
      // ERR-0011: ninguna condicion validaba tenant -- Instructor/Tutor/Estudiante de OTRO
      // tenant leian y (staff) escribian eventos ajenos.
      allow read: if (isInstructor() || isTutor() || isEstudiante())
        && resource.data.tenantId == currentTenantId();
      allow create: if isInstructor() && request.resource.data.tenantId == currentTenantId();
      allow update, delete: if isInstructor() && resource.data.tenantId == currentTenantId();
    }

    match /implementos/{docId} {
      // Fix tutor-role-end-to-end (2026-07-14): consultores (Tutor/Estudiante) pueden LEER la
      // Tienda (implementos). Escritura solo Admin.
      allow read: if isInstructor() || isTutor() || isEstudiante();
      allow create, update, delete: if isAdmin();
    }

    // ERR-0011: ninguna condicion validaba tenant -- un Instructor/Admin de OTRO tenant
    // leia y escribia solicitudes de compra ajenas. `tenantId` se agrego recien al modelo
    // (tipos.ts::SolicitudCompra, tiendaApi.ts::crearSolicitudCompra, derivado del propio
    // estudiante) -- antes no existia ningun campo para aislar esta coleccion por tenant.
    match /solicitudesCompra/{docId} {
      allow read: if isInstructor() && resource.data.tenantId == currentTenantId();
      allow create, update: if isInstructor() && request.resource.data.tenantId == currentTenantId();
      allow delete: if isAdmin() && resource.data.tenantId == currentTenantId();
    }

    // Solicitudes de fabricación física de carnets (Carnetizacion.tsx -> Master/Aliant ->
    // MasterDashboard.tsx). Un carnet físico es indispensable para el estudiante (asistencia
    // a clase, eventos), así que la solicitud que lo pide NUNCA se pierde: `create` y
    // `update` pasan exclusivamente por las Cloud Functions `solicitarFabricacionCarnets` /
    // `actualizarEstadoSolicitudCarnets` (mismo criterio ya usado para `estudiantes`/`sedes`,
    // ver academico/carnets.js) -- la cantidad, el lote de estudiantes, y la reversión de
    // `carnetGenerado` al rechazar deben calcularse server-side contra datos reales de otra
    // colección, algo que una regla de Firestore no puede validar. `delete` queda bloqueado
    // sin excepción, ni siquiera para SuperAdmin: es el registro de trazabilidad/auditoría/
    // recuperación de una fabricación física, debe sobrevivir sin importar en qué estado
    // termine (pendiente, en_producción, rechazado o enviado). El club solo LEE las suyas.
    match /solicitudes_carnets/{docId} {
      allow read: if isSuperAdmin() || (isAdmin() && resource.data.tenantId == currentTenantId());
      allow create, update: if false;
      allow delete: if false;
    }

    match /solicitudesInscripcion/{docId} {
      allow read: if isInstructor();
      allow create, update: if isInstructor();
      allow delete: if isAdmin();
    }

    match /transaccionesPago/{docId} {
      allow read: if isInstructor();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ERR-0011: ninguna condicion validaba tenant -- un Instructor/Admin de OTRO tenant
    // leia y escribia movimientos financieros ajenos (dato especialmente sensible).
    match /finanzas/{docId} {
      allow read: if isInstructor() && resource.data.tenantId == currentTenantId();
      allow create: if isAdmin() && request.resource.data.tenantId == currentTenantId();
      allow update, delete: if isAdmin() && resource.data.tenantId == currentTenantId();
    }

    // =========================================================================
    // MÃ³dulo acadÃ©mico â€” colecciones por tenant
    // =========================================================================

    // Conexiones de Google Drive (solo admin del tenant)
    match /tenants/{tenantId}/driveConnections/{connId} {
      allow read, write: if isAdmin()
        && currentTenantId() == tenantId;
    }

    // Invitaciones de usuarios acadÃ©micos (Estudiante / Tutor)
    match /tenants/{tenantId}/invitaciones/{invId} {
      allow read: if isAdmin()
        && currentTenantId() == tenantId;
      allow create, update: if isAdmin()
        && currentTenantId() == tenantId;
      allow delete: if false;
    }

    // VÃ­nculos Tutor â†” Estudiante (N:M)
    match /tenants/{tenantId}/vinculos/{vinculoId} {
      allow read: if authenticated()
        && currentTenantId() == tenantId
        && (isAdmin() || isTutor());
      allow write: if isAdmin()
        && currentTenantId() == tenantId;
    }

    // Espacios fÃ­sicos de sede
    match /tenants/{tenantId}/espacios/{espacioId} {
      allow read: if authenticated()
        && currentTenantId() == tenantId;
      allow write: if isAdmin()
        && currentTenantId() == tenantId;
    }

    // Programas acadÃ©micos
    match /tenants/{tenantId}/programasAcademicos/{programaId} {
      allow read: if authenticated()
        && currentTenantId() == tenantId;
      allow write: if isAdmin()
        && currentTenantId() == tenantId;
    }

    // Ejecuciones de programa por grupo
    match /tenants/{tenantId}/ejecucionesPrograma/{ejecucionId} {
      allow read: if authenticated()
        && currentTenantId() == tenantId
        && !isTutor();
      allow write: if isInstructor()
        && currentTenantId() == tenantId;
    }

    // Roster explícito de estudiantes matriculados en una ejecución de programa.
    // Baja frecuencia (acción administrativa) → escritura directa gateada por rol,
    // a diferencia de `asistencias` (Decisión 3) que sí exige Admin SDK por ser
    // alta frecuencia y requerir cruce de pertenencia.
    match /tenants/{tenantId}/ejecucionesPrograma/{ejecucionId}/inscripciones/{estudianteId} {
      allow read: if authenticated()
        && currentTenantId() == tenantId
        && !isTutor();
      allow create: if isInstructor()
        && currentTenantId() == tenantId
        && request.resource.data.estudianteId == estudianteId
        && request.resource.data.tenantId == tenantId;
      // No hay `request.resource` en `delete` (Firestore Security Rules: el
      // documento entrante no existe en un borrado) — validar solo rol+tenant,
      // igual que el patrón ya usado para `asignaciones` en este mismo archivo.
      allow delete: if isInstructor()
        && currentTenantId() == tenantId;
      allow update: if false; // re-matricular = delete + create; sin estados intermedios ambiguos
    }

    // Jornadas de instruccion
    match /tenants/{tenantId}/jornadas/{jornadaId} {
      // Cualquier usuario autenticado del tenant puede LEER las jornadas (son horarios de
      // clase: grupo/sede/hora/instructor, no datos sensibles por-alumno). Cubre Estudiante
      // y — fix tutor-role-end-to-end (2026-07-14) — también Tutor: el padre ve la Agenda en
      // modo solo lectura y el CLIENTE (AgendaView) la filtra a las clases de su hijo por
      // sede+grupo. La restricción previa por `estudianteId == uid` no aplicaba al modelo
      // real de jornadas (no tienen estudianteId) y bloqueaba al Tutor por completo.
      allow read: if authenticated()
        && currentTenantId() == tenantId;
      allow create: if isInstructor()
        && currentTenantId() == tenantId;
      // Las transiciones de estado se hacen via Cloud Function (no directamente).
      // Subtarea 12.2: el "maestro asignado" (resource.data.instructorId == uid)
      // puede editar solo SU jornada; Admin/SuperAdmin pueden editar cualquiera del
      // tenant. Editor/Asistente NO asignado queda rechazado en backend.
      //
      // Extension posterior al cierre del modulo 12 (matriz de roles de Agenda, ver
      // CIERRE CENTRO DE ESTUDIOS.md): se agrega un tercer OR para Asistente/Editor que
      // el Admin autorizo explicitamente via el flag `permisoEdicionAgenda` del propio
      // documento de usuario (tipos.ts, Usuario.permisoEdicionAgenda). `hasCurrentUser()`
      // guarda el `get()` -- sin esa guarda, `currentUser()` lanza si el uid autenticado
      // no tiene un documento real en `usuarios/{uid}` (p.ej. contextos de test que solo
      // usan custom claims). El `get()` en si mismo es gratis en la practica: Firestore
      // cachea lecturas repetidas al MISMO documento dentro de una misma evaluacion de
      // regla, y `currentUser()` ya se invoca (via currentTenantId()/currentRole()) en la
      // mayoria de los casos reales sin custom claims. Se acota a `currentRole() in
      // ['Asistente', 'Editor']` a proposito: el flag SOLO aplica a esos dos roles (Admin/
      // SuperAdmin ya entran por isAdmin(), Maestro por instructorId) -- si el campo
      // quedara true en el documento de un Maestro por error de datos, no le da acceso a
      // jornadas ajenas.
      allow update: if isInstructor()
        && currentTenantId() == tenantId
        && (
          isAdmin()
          || resource.data.instructorId == request.auth.uid
          || (
            currentRole() in ['Asistente', 'Editor']
            && hasCurrentUser()
            && currentUser().permisoEdicionAgenda == true
          )
        );
      // Ampliacion posterior al cierre inicial de esta extension (decision de producto
      // explicita del usuario, ver CIERRE CENTRO DE ESTUDIOS.md): "eliminar" ya NO se
      // restringe a Admin/SuperAdmin -- replica EXACTO el mismo criterio de tres OR ya
      // usado en `update` arriba (Admin/SuperAdmin siempre; Maestro asignado solo SU
      // jornada via `resource.data.instructorId`; Asistente/Editor solo con el flag
      // `permisoEdicionAgenda == true`, guardado por `hasCurrentUser()` por la misma razon
      // documentada en `update`). Esta regla es la unica defensa de backend contra el
      // BORRADO FISICO real: el borrado seguro (guarda de 12.6 -- no borrar una jornada ya
      // operada/con asistencia real) es una validacion de APLICACION, no de esta regla --
      // vive en `evaluarEliminacionSegura`/`eliminarJornadaSegura`
      // (servicios/academico/jornadaRepository.ts) y corre ANTES de que el cliente le pida
      // a Firestore que borre el documento. Ampliar aca a Maestro/Asistente-Editor no abre
      // una via nueva de bypass de esa guarda: el UNICO camino real de "eliminar clase"
      // (icono de la parrilla + boton del modal, ambos sobre `useEliminacionJornadaSegura`)
      // siempre pasa por `eliminarJornadaSegura` antes de tocar Firestore, para cualquier
      // rol. Ver nota separada sobre `eliminarJornadasEnLote` (primitiva de limpieza de
      // previews de AsignacionesView.tsx, sin esta guarda) en CIERRE CENTRO DE ESTUDIOS.md.
      allow delete: if isInstructor()
        && currentTenantId() == tenantId
        && (
          isAdmin()
          || resource.data.instructorId == request.auth.uid
          || (
            currentRole() in ['Asistente', 'Editor']
            && hasCurrentUser()
            && currentUser().permisoEdicionAgenda == true
          )
        );
    }

    match /tenants/{tenantId}/jornadas/{jornadaId}/auditoria/{auditId} {
      allow read: if isInstructor()
        && currentTenantId() == tenantId;
      allow create: if isInstructor()
        && currentTenantId() == tenantId;
      allow update, delete: if false;
    }

    // Asistencia (check-in/check-out) por estudiante sobre una jornada.
    // Escritura exclusiva del callable `registrarAsistenciaJornada` (Admin SDK,
    // bypassa reglas) porque valida pertenencia contra el roster de inscripciones
    // (design.md, Decision 3) — alta frecuencia de escaneo, no vale la pena
    // duplicar esa lógica de cruce en reglas. El cliente NUNCA escribe directo.
    match /tenants/{tenantId}/jornadas/{jornadaId}/asistencias/{estudianteId} {
      allow read: if authenticated()
        && currentTenantId() == tenantId;
      allow write: if false;
    }

    // Checkpoint pedagógico de materiales de la clase (WS-4, Clase en Vivo §9). A diferencia
    // de `asistencias` (server-side por el cruce de roster), esto lo escribe el STAFF desde el
    // cliente (baja frecuencia, sin cruce): lo gatea `isInstructor` + tenant. Lectura: staff
    // del tenant (es dato pedagógico/operativo, no del alumno).
    match /tenants/{tenantId}/jornadas/{jornadaId}/checkpointMateriales/{asignacionId} {
      allow read, write: if isInstructor()
        && currentTenantId() == tenantId;
    }

    // Biblioteca: recursos acadÃ©micos
    match /tenants/{tenantId}/recursos/{recursoId} {
      allow read: if authenticated()
        && currentTenantId() == tenantId;
      allow create, update: if isInstructor()
        && currentTenantId() == tenantId;
      allow delete: if isAdmin()
        && currentTenantId() == tenantId;
    }

    // Banco de preguntas de un recurso tipo 'quiz' de la biblioteca. Mismo criterio de
    // gating que recursos/asignaciones (isInstructor = Admin/SuperAdmin/Editor/Asistente/Maestro).
    match /tenants/{tenantId}/quizzes/{recursoId} {
      allow read: if authenticated()
        && currentTenantId() == tenantId;
      allow create, update, delete: if isInstructor()
        && currentTenantId() == tenantId;
    }

    // Asignaciones acadÃ©micas
    match /tenants/{tenantId}/asignaciones/{asignacionId} {
      // Lectura para cualquier usuario autenticado del tenant (Estudiante y — fix
      // tutor-role-end-to-end 2026-07-14 — Tutor): son materiales académicos de las clases
      // del tenant, que la Agenda muestra junto a cada jornada. El cliente ya filtra a las
      // clases del hijo. La restricción previa por `estudianteId == uid` no aplicaba
      // (bloqueaba al Tutor y las asignaciones se indexan por jornada/grupo, no por uid).
      allow read: if authenticated()
        && currentTenantId() == tenantId;
      // Solo instructores pueden crear/modificar/eliminar asignaciones
      allow create, update: if isInstructor()
        && currentTenantId() == tenantId;
      allow delete: if isInstructor()
        && currentTenantId() == tenantId;
    }

    // Progreso del estudiante
    match /tenants/{tenantId}/progreso/{uid}/{asignacionId} {
      allow read: if canReadProgress(tenantId, uid);
      allow write: if canWriteOwnStudentProgress(tenantId, uid);
    }

    // Ruta real usada por Cloud Functions/repositorios: progreso/{uid}/asignaciones/{asignacionId}
    match /tenants/{tenantId}/progreso/{uid}/asignaciones/{asignacionId} {
      allow read: if canReadProgress(tenantId, uid);
      allow write: if canWriteOwnStudentProgress(tenantId, uid);
    }

    // Visualizaciones de video de YouTube (reemplazo de Drive SOLO para video, decisión de
    // producto 2026-07: costo $0 de hosting + tracking real de reproducción vía la IFrame
    // Player API -- ver servicios/academico/visualizacionRepository.ts). Estructura por
    // RECURSO -> alumno (no alumno -> asignación como `progreso` arriba) para que el
    // reporte de staff (Paso 7) pueda listar todos los alumnos de un recurso sin
    // collectionGroup query. Mismo criterio de lectura que `progreso` pero ampliado a
    // isInstructor() (no solo isAdmin) porque el reporte lo consume cualquier staff
    // operativo (Maestro/Editor/Asistente), igual que `metricasEstudiante`/`actividadLogs`.
    match /tenants/{tenantId}/visualizaciones/{recursoId}/alumnos/{uid} {
      allow read: if authenticated()
        && currentTenantId() == tenantId
        && (request.auth.uid == uid || isInstructor() || tutorLinkedToStudent(tenantId, uid));
      allow write: if canWriteOwnStudentProgress(tenantId, uid);
    }

    // Logs de actividad académica
    match /tenants/{tenantId}/actividadLogs/{logId} {
      allow create: if authenticated()
        && currentTenantId() == tenantId
        && request.resource.data.estudianteId == request.auth.uid;
      allow read: if authenticated()
        && currentTenantId() == tenantId
        && (request.auth.uid == resource.data.estudianteId || isInstructor());
    }

    // Métricas agregadas de progreso del estudiante
    match /tenants/{tenantId}/metricasEstudiante/{estudianteId} {
      allow read: if authenticated()
        && currentTenantId() == tenantId
        && (request.auth.uid == estudianteId || isInstructor());
      // El frontend escribe estas métricas agregadas al registrar actividad
      allow write: if authenticated()
        && currentTenantId() == tenantId
        && request.auth.uid == estudianteId;
    }

    // Métricas de ASISTENCIA FÍSICA acumuladas (horas reales de clase en vivo), WS-2 /
    // `Módulo Clase en Vivo.txt` §7/§11. La clave `{estudianteId}` es el DOC-ID del estudiante
    // (el que se escanea del QR), NO el authUid — por eso la identidad se resuelve por EMAIL
    // vía get() sobre el doc del estudiante, igual que `historialNotificaciones` (y NO con
    // `request.auth.uid == estudianteId`, que aquí sería incorrecto).
    //
    // Escritura EXCLUSIVA del callable `registrarAsistenciaJornada` (Admin SDK, bypassa reglas)
    // al hacer check-out. El cliente NUNCA escribe: es un acumulado derivado.
    // Lectura: staff del tenant (reportes/KPIs §11), el tutor vinculado (el padre ve las horas
    // de su hijo), o el propio estudiante.
    match /tenants/{tenantId}/metricasAsistencia/{estudianteId} {
      allow read: if authenticated()
        && currentTenantId() == tenantId
        && (
          isInstructor()
          || (isTutor() && get(/databases/$(database)/documents/estudiantes/$(estudianteId)).data.tutor.correo == request.auth.token.email)
          || (isEstudiante() && get(/databases/$(database)/documents/estudiantes/$(estudianteId)).data.correo == request.auth.token.email)
        );
      allow write: if false;
    }

    // Buzón de notificaciones (fix tutor-role-end-to-end 2026-07-14). Colección raíz
    // `historialNotificaciones`: cada doc referencia un `estudianteId`. Staff ve todo; un
    // consultor (Tutor/Estudiante) ve SOLO las de su(s) estudiante(s), validando contra el
    // doc del estudiante (tutor.correo para Tutor, correo para Estudiante == token.email).
    // ERR-0011: ninguna rama validaba tenant -- Staff (isInstructor) de OTRO tenant leia el
    // buzon COMPLETO de notificaciones de todos los tenants (el bug de mayor volumen: se
    // dispara en cada carga del buzon, sin filtro). `tenantId` se agrego al modelo
    // (tipos.ts::NotificacionHistorial) y a TODOS los puntos de escritura -- client-side
    // (notificacionesApi.ts, notificacionCheckoutService.ts) y Cloud Functions cron
    // (recordatoriosPago.js, recordatoriosEstudio.js, notificarEvento.js,
    // functions/index.js::notificarAvance; asistencia.js y recogidaScheduler.js ya lo
    // escribian) -- por eso aca se usa el patron simple resource.data.tenantId, igual que
    // el resto de colecciones, en vez de derivarlo por get() sobre el estudiante.
    match /historialNotificaciones/{notifId} {
      allow read: if (isInstructor() && resource.data.tenantId == currentTenantId())
        || (isTutor() && resource.data.tenantId == currentTenantId() && get(/databases/$(database)/documents/estudiantes/$(resource.data.estudianteId)).data.tutor.correo == request.auth.token.email)
        || (isEstudiante() && resource.data.tenantId == currentTenantId() && get(/databases/$(database)/documents/estudiantes/$(resource.data.estudianteId)).data.correo == request.auth.token.email);
      allow create: if isInstructor() && request.resource.data.tenantId == currentTenantId();
      // Marcar como leída: staff, o el consultor dueño — y solo puede tocar el campo `leida`.
      allow update: if (isInstructor() && resource.data.tenantId == currentTenantId())
        || (
          resource.data.tenantId == currentTenantId()
          && (
            (isTutor() && get(/databases/$(database)/documents/estudiantes/$(resource.data.estudianteId)).data.tutor.correo == request.auth.token.email)
            || (isEstudiante() && get(/databases/$(database)/documents/estudiantes/$(resource.data.estudianteId)).data.correo == request.auth.token.email)
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida'])
        );
      allow delete: if false;
    }

    // =========================================================================
    // Catch-all: denegar todo lo no declarado
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

