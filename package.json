{
  "name": "tudojang-gestion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:bundle-security": "node --test scripts/verificar-bundle-seguro.test.js",
    "preview": "vite preview",
    "test": "npm run test:app",
    "test:app": "jest --runInBand",
    "test:functions": "npm --prefix functions test",
    "test:functions:drive": "jest --runInBand --testMatch \"**/functions/academico/drive.test.js\" --testPathIgnorePatterns \"node_modules\"",
    "test:functions:full": "npm run test:functions && npm run test:functions:drive",
    "test:node": "node --test scripts/*.test.js",
    "test:all": "npm run test:app && npm run test:functions:full && npm run test:node",
    "test:infra": "node --test scripts/infraestructura-pruebas.test.js",
    "test:report": "jest --coverage --json --outputFile=reports/tdd-refactor-report.json",
    "test:coverage": "jest --coverage --json --outputFile=coverage/coverage-summary.json",
    "test:functions:emulator": "firebase emulators:exec --project demo-tudojang --only firestore \"node --test functions/test/asistente.integration.test.js\"",
    "test:firestore-rules": "firebase emulators:exec --project demo-tudojang --only firestore \"node --test functions/test/firestore-rules.security.test.js functions/test/firestore-rules.behavior.test.js\"",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@google/genai": "^1.8.0",
    "@hookform/resolvers": "^3.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.2.0",
    "firebase-admin": "^13.6.1",
    "framer-motion": "^11.2.12",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^0.473.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.52.1",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.6.3",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "autoprefixer": "^10.4.20",
    "cypress": "^13.13.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.2",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
