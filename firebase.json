{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/webhookWompi",
        "function": "webhookWompi"
      },
      {
        "source": "/api/debugLogs",
        "function": "getDebugLogs"
      },
      {
        "source": "/api/verificarTransaccion",
        "function": "verificarTransaccionWompi"
      },
      {
        "source": "/api/enviarBienvenidaTudojang",
        "function": "enviarBienvenidaTudojang"
      },
      {
        "source": "/api/provisionarUsuarioOnboarding",
        "function": "provisionarUsuarioOnboarding"
      },
      {
        "source": "/api/activarSuscripcionManual",
        "function": "activarSuscripcionManual"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}