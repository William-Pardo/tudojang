rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // --- HELPERS ---
    // Verifica que el usuario autenticado pertenece al tenant de la ruta
    function perteneceAlTenant(tenantId) {
      return request.auth != null && request.auth.token.tenantId == tenantId;
    }

    // --- EVENTOS: Banners e imágenes de eventos por tenant ---
    match /tenants/{tenantId}/eventos/{eventId}/{imageName} {
      // Lectura pública: cualquiera puede ver el banner (incluso sin login, para la landing pública)
      allow read: if true;
      // Escritura/Eliminación: solo el admin del tenant correspondiente
      allow write, delete: if perteneceAlTenant(tenantId);
    }

    // --- FIRMAS: Documentos de consentimiento por tenant y estudiante ---
    match /tenants/{tenantId}/firmas/{estudianteId}/{fileName} {
      // Lectura: solo usuarios autenticados del mismo tenant
      allow read: if perteneceAlTenant(tenantId);
      // Escritura: solo el tenant al que pertenece el estudiante
      allow write, delete: if perteneceAlTenant(tenantId);
    }

    // --- COMPROBANTES: Imágenes de comprobantes de pago por tenant ---
    match /tenants/{tenantId}/comprobantes/{fileName} {
      // Lectura: solo el tenant dueño puede ver los comprobantes
      allow read: if perteneceAlTenant(tenantId);
      // Escritura: cualquier usuario autenticado del tenant puede subir su comprobante
      allow write: if perteneceAlTenant(tenantId);
      allow delete: if perteneceAlTenant(tenantId);
    }

  }
}
