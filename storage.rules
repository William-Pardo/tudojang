rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /tenants/{tenantId}/eventos/{eventId}/{imageName} {
      // Permitir lectura a cualquier usuario autenticado de la app
      allow read: if request.auth != null;
      
      // Permitir escritura y eliminación solo si el usuario pertenece al tenant dueño del path.
      // Se valida de dos formas (por la dualidad de tenantId en el modelo de datos):
      //   1. El tenantId del perfil del usuario coincide directamente con la ruta
      //   2. El documento tenant del usuario (tenants/{uid}) tiene el tenantId que coincide con la ruta
      allow write, delete: if request.auth != null 
        && (
          firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.tenantId == tenantId
          || firestore.get(/databases/(default)/documents/tenants/$(request.auth.uid)).data.tenantId == tenantId
        );
    }
  }
}
